{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "weather-adf-ajh"
		},
		"AzureDatabricksBronzeLink_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'AzureDatabricksBronzeLink'"
		},
		"AzureDatabrickslinksilver_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'AzureDatabrickslinksilver'"
		},
		"AzureDatabricksBronzeLink_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "0620-173953-7968nc0y"
		},
		"AzureDatabrickslinksilver_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "0620-173953-7968nc0y"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/AzureDatabricksBronzeLink')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureDatabricks",
				"typeProperties": {
					"domain": "https://adb-7405608381363108.8.azuredatabricks.net",
					"accessToken": {
						"type": "SecureString",
						"value": "[parameters('AzureDatabricksBronzeLink_accessToken')]"
					},
					"existingClusterId": "[parameters('AzureDatabricksBronzeLink_properties_typeProperties_existingClusterId')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/AzureDatabrickslinksilver')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureDatabricks",
				"typeProperties": {
					"domain": "https://adb-7405608381363108.8.azuredatabricks.net",
					"accessToken": {
						"type": "SecureString",
						"value": "[parameters('AzureDatabrickslinksilver_accessToken')]"
					},
					"existingClusterId": "[parameters('AzureDatabrickslinksilver_properties_typeProperties_existingClusterId')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/daily_weather_pipeline')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "pipeline for weather_dashboard",
				"activities": [
					{
						"name": "Ingest Bronze",
						"description": "Notebook to get raw data from weather API. ",
						"type": "DatabricksNotebook",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 3,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"notebookPath": "/Users/alejh01@outlook.com/Weather_Project/01_ingest_bronze"
						},
						"linkedServiceName": {
							"referenceName": "AzureDatabricksBronzeLink",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "Transform Silver",
						"description": "From raw bronze data into silver to transform",
						"type": "DatabricksNotebook",
						"dependsOn": [
							{
								"activity": "Ingest Bronze",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 3,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"notebookPath": "/Users/alejh01@outlook.com/Weather_Project/02_transform_silver"
						},
						"linkedServiceName": {
							"referenceName": "AzureDatabrickslinksilver",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "Build Gold",
						"type": "DatabricksNotebook",
						"dependsOn": [
							{
								"activity": "Transform Silver",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"notebookPath": "/Users/alejh01@outlook.com/Weather_Project/03_build_gold"
						},
						"linkedServiceName": {
							"referenceName": "AzureDatabrickslinksilver",
							"type": "LinkedServiceReference"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/AzureDatabricksBronzeLink')]",
				"[concat(variables('factoryId'), '/linkedServices/AzureDatabrickslinksilver')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Daily_Weather_Trigger')]",
			"type": "Microsoft.DataFactory/factories/triggers",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Automatically run notebooks",
				"annotations": [],
				"runtimeState": "Stopped",
				"pipelines": [
					{
						"pipelineReference": {
							"referenceName": "daily_weather_pipeline",
							"type": "PipelineReference"
						},
						"parameters": {}
					}
				],
				"type": "ScheduleTrigger",
				"typeProperties": {
					"recurrence": {
						"frequency": "Day",
						"interval": 1,
						"startTime": "2026-06-22T14:30:00",
						"endTime": "2026-07-04T15:00:00",
						"timeZone": "Central Standard Time",
						"schedule": {}
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/pipelines/daily_weather_pipeline')]"
			]
		}
	]
}